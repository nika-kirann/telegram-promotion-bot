# Required
BOT_TOKEN=123456789:YOUR_BOTFATHER_TOKEN
GROUP_ID=-1001234567890
ADMIN_IDS=111111111,222222222
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
PORT=8000

# Optional
MONGODB_DB=promotion_bot
# Telegram username (without @) for the "Contact Admin" button; empty = in-bot message relay to admins
ADMIN_CONTACT=
# Initial defaults (both can be changed live from /admin and are stored in MongoDB)
REQUIRE_APPROVAL=false
INVITE_INTERVAL_HOURS=6
